# =====================================================================
# LOCAL DEVELOPMENT ONLY (laptop). Never copied to the VM.
#   cp .env.example .env
#   docker compose -f docker-compose.local.yml up --build
#
# Milestone 4: the cloud deployment uses NO .env file. On the VM the DB
# password lives in Secret Manager and is read at runtime by the VM's
# service account; everything else is plain config in docker-compose.yml.
# This file only configures the throwaway Postgres container on a laptop.
# .env is in .gitignore AND .dockerignore: it never reaches git or an image.
# =====================================================================
POSTGRES_USER=gridpulse
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=gridpulse

# Dashboard port on the laptop (http://localhost)
FRONTEND_PORT=80

# =====================================================================
# Native (no Docker) backend - Milestone 1 style, laptop only.
#   export these in your shell (the app does not read .env files itself):
#   set -a; source .env; set +a
# =====================================================================
DATABASE_URL=postgresql+psycopg2://gridpulse:gridpulse@localhost:5432/gridpulse
STORAGE_BACKEND=local
UPLOAD_DIRECTORY=./uploads
MODEL_PATH=./ml/model.joblib
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
