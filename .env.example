# =====================================================================
# Docker Compose (Milestone 3)
#   cp .env.example .env    then set a real POSTGRES_PASSWORD.
#   .env is in .gitignore AND .dockerignore: it never reaches git or an image.
#   Use letters/digits only in the password (it is placed inside a URL).
# =====================================================================
POSTGRES_USER=gridpulse
POSTGRES_PASSWORD=change-me
POSTGRES_DB=gridpulse

# Artifact Registry repo + version tag the images are built/pushed/pulled as
REGISTRY=us-central1-docker.pkg.dev/gridpulse-509202/gridpulse
IMAGE_TAG=v1

# Host port for the dashboard: 80 -> http://<host>/ . Set 8080 if Milestone 2
# served the app at http://<VM IP>:8080 (the VM firewall must allow that port).
FRONTEND_PORT=80

# =====================================================================
# Native (no Docker) backend - Milestone 1/2 style.
#   cd backend && cp ../.env.example .env
#   Compose ignores everything below; the backend reads it from backend/.env.
# =====================================================================

# --- Database ---
DATABASE_URL=postgresql+psycopg2://gridpulse:gridpulse@localhost:5432/gridpulse

# --- Storage ---
UPLOAD_DIRECTORY=./uploads
MODEL_PATH=./ml/model.joblib

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Risk thresholds (predicted_load / effective_capacity ratio) ---
RISK_WATCH_PCT=0.75
RISK_HIGH_PCT=0.85
RISK_CRITICAL_PCT=0.95

# --- Forecast ---
FORECAST_HORIZON_HOURS=24

# --- Uploads ---
MAX_UPLOAD_MB=10
