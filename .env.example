# --- Database ---
DATABASE_URL=postgresql+psycopg2://gridpulse:gridpulse@localhost:5432/gridpulse

# --- Storage ---
UPLOAD_DIRECTORY=./uploads
MODEL_PATH=./ml/model.joblib

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Risk thresholds (predicted_load / effective_capacity ratio) ---
RISK_WATCH_PCT=0.75
RISK_HIGH_PCT=0.85
RISK_CRITICAL_PCT=0.95

# --- Forecast ---
FORECAST_HORIZON_HOURS=24

# --- Uploads ---
MAX_UPLOAD_MB=10
