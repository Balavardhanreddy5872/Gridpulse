# secrets (any .env variant, including backups like .env.m3.bak)
.env
.env.*
**/.env
**/.env.*
*.env
!.env.example
!**/.env.example
!*.env.example
# service-account key files must never exist, let alone be committed
*-key.json
*credentials*.json
service-account*.json

# test artifacts
backend/tests/test_uploads/
backend/tests/test_gridpulse.db

# python
__pycache__/
*.pyc
venv/
.venv/
*.egg-info/

# node
node_modules/
dist/
build/

# uploads (runtime data, not code)
uploads/*
!uploads/.gitkeep

# os/editor
.DS_Store
.vscode/

# archives (a repo tarball can contain .env files)
*.tar.gz
*.zip
